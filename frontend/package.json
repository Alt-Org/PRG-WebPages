{
  "name": "prg-webpages",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "prg": "./changemewhenready.ts"
  },
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build --no-lint",
    "start": "next start",
